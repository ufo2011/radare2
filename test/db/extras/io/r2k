# Run with make -C test r2k on Linux; all driver operations are mocked.
NAME=r2k backend and write protection
FILE=r2k://
ARGS=-n
CMDS=<<EOF
:e r2k.io
:dp 0x7b
:e r2k.io=1
p8 1
:dp
:b 2
p8 1
:e r2k.io
:dp
:b   1   0x7b
:e r2k.io
:dp
:e r2k.wp
:W 0
:e r2k.wp
:e r2k.wp=1
EOF
EXPECT=<<EOF
0
123
1
7e
123
05
2
0
1
123
true
false
true
EOF
RUN

NAME=r2k process and register aliases
FILE=r2k://
ARGS=-n
CMDS=<<EOF
:p 123~pid =
:dm 0x7b~pid =
:b 1 123
:dm~pid =
:p* 123
:R~0x1[-1]
:dr~0x1[-1]
:Rp~^ [0]:0
:dR~^ [0]:0
:b 0
:M~start_addr
:dm~start_addr
EOF
EXPECT=<<EOF
pid = 123
pid = 123
pid = 123
'f pid.123.test.0.start=0x1000
'f pid.123.test.0.end=0x2000
'f pid.123.task_struct = 0x00abcdef
0x1
0x1
[*]
[*]
start_addr: 0x1000
start_addr: 0x1000
EOF
RUN

