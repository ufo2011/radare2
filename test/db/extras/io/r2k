NAME=r2k rejects malformed and overflowing inputs without changing state
FILE=r2k://
ARGS=-n
CMDS=<<EOF
:dp 123
:b 1 123
:e r2k.io=2junk~nomatch
:e r2k.io=-1~nomatch
:e r2k.io=3~nomatch
:e r2k.io=1 0~nomatch
:e r2k.wp=2~nomatch
:e r2k.wp=bad~nomatch
:b 1~nomatch
:b 1 2147483648~nomatch
:dp -1~nomatch
:dp 18446744073709551616~nomatch
:dp
:e r2k.io
:e r2k.wp
:rl~nomatch
:rl 0x1000~nomatch
:rl 0x1000 0~nomatch
:rl 0x1000 -1~nomatch
:rl 0x1000 2147483648~nomatch
:rl 0x1000 4x~nomatch
:rl 0xffffffffffffffff 2~nomatch
:rp bad 0x1000 4~nomatch
:wlx 0x1000 zz~nomatch
:wlx 0x1000 123~nomatch
:wpx 123 0x1000~nomatch
:wPx 18446744073709551616 00~nomatch
:e r2k.io
:dp
EOF
EXPECT=<<EOF
123
123
1
true
1
123
EOF
RUN
